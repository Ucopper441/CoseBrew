---
import { menu } from '../data/menu';
import Arrow from '../components/Arrow.astro';
const directions = 'https://www.google.com/maps/search/?api=1&query='+encodeURIComponent('Cose Brew 2 Jalan Pandan Kemajuan A Kuala Lumpur');
---
<!doctype html>
<html lang="ms">
<head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="description" content="Get to know Cose Brew: coffee, good company and table games in Kampung Pandan, Kuala Lumpur. Explore the menu and enquire about coffee catering."/><title>Cose Brew — Kopi, kad & kawan.</title><link rel="icon" href="/images/logo.png"/></head>
<body>
  <div class="concept">A little preview of what’s brewing. <span>Unofficial website concept · details subject to confirmation</span></div>
  <header><a class="brand" href="#" aria-label="Cose Brew home"><img src="/images/logo.png" alt=""/><span>cose<span class="brand-dot">.</span></span></a><nav aria-label="Main navigation"><a href="#menu">The menu</a><a href="#hangout">The good times</a><a href="#catering">Coffee catering</a></nav><a class="nav-cta" href="#enquire">Let’s talk <span><Arrow /></span></a></header>
  <main>
    <section class="hero"><div class="hero-copy"><p class="eyebrow"><span class="tiny-star">✳</span> YOUR NEIGHBOURHOOD COFFEE SPOT · KL</p><h1>Singgah kopi.<br/>Stay for the<br/><em>company.</em></h1><p class="intro">Secawan kopi. Cerita tak habis-habis.<br/>Your little corner in Kampung Pandan for coffee,<br class="desktop"/> catch-ups, and just one more round.</p><div class="actions"><a class="button" href="#menu">Find your coffee <span><Arrow /></span></a><a class="text-link" href={directions} target="_blank" rel="noopener">Come on over <Arrow /></a></div><div class="hero-foot"><span>BREWING FROM 3PM</span><span>KAMPUNG PANDAN, KL <Arrow /></span></div></div><div class="hero-art"><img class="hero-photo" src="/images/coffees.webp" alt="Three iced coffees together on a wooden café table" fetchpriority="high"/><div class="photo-note">Good coffee.<br/>Even better company.<span>♡</span></div><div class="roundel">KOPI & KAWAN<br/><b>cose.</b><br/>SINGGAH DULU</div></div></section>
    <div class="ticker" aria-hidden="true"><span>KOPI DULU</span> ✳ <span>CERITA KEMUDIAN</span> ✳ <span>ONE MORE ROUND?</span> ✳ <span>SEE YOU AT COSE.</span> ✳</div>
    <section class="favourites section"><div class="section-heading"><div><p class="eyebrow">A GOOD PLACE TO START</p><h2>Meet your next<br/><em>usual.</em></h2></div><p>For the first sip, or the fiftieth visit.<br/>A few recommended picks from our menu.</p></div><div class="favourite-grid"><figure class="feature-photo"><img src="/images/coffee.webp" loading="lazy" alt="An iced Cose coffee in front of the café’s poster wall"/><figcaption>A little taste of Cose. / Coffee pictured for atmosphere.</figcaption></figure><div class="picks"><article><span class="number">01 / HOUSE PICK</span><h3>Kopi Cose <span>13.90</span></h3><p>Espresso, fresh milk, palm sugar & creamer.</p></article><article><span class="number">02 / CREAMY COMFORT</span><h3>Better Cream <span>14.90</span></h3><p>Espresso, milk, butterscotch & cream.</p></article><article><span class="number">03 / A LITTLE EXTRA</span><h3>Loyal Cream <span>14.90</span></h3><p>Espresso, milk, butterscotch, pecan & cream.</p></article><a class="text-link" href="#menu">There’s more where that came from <Arrow /></a></div></div></section>
    <section id="menu" class="menu-section section"><div class="section-heading"><div><p class="eyebrow">WHAT ARE YOU HAVING?</p><h2>Something for<br/><em>every mood.</em></h2></div><p>Coffee people. Matcha people. Dessert people.<br/>We’ve got a spot for you.</p></div><div class="tabs" role="tablist" aria-label="Menu categories">{Object.keys(menu).map((category,i)=><button id={`tab-${i}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`panel-${i}`} tabindex={i===0?0:-1}>{category}</button>)}</div>{Object.entries(menu).map(([category,items],i)=><div class="menu-panel" id={`panel-${i}`} role="tabpanel" aria-labelledby={`tab-${i}`} hidden={i!==0}><div class="menu-grid">{items.map(([name,price,description,recommended])=><article class="menu-item"><div><h3>{name}{recommended&&<span class="recommended" aria-label="Recommended">✳</span>}</h3><p>{description}</p></div><span class="price">{typeof price==='number'?`RM${price.toFixed(2)}`:'Ask us'}</span></article>)}</div></div>)}<p class="menu-note">✳ Recommended · Prices in MYR. Demo menu transcribed from the supplied menu photo; final availability and prices to be confirmed.</p></section>
    <section id="hangout" class="hangout"><div class="hangout-image"><img src="/images/games.webp" loading="lazy" alt="Card games and tabletop games laid out for friends at Cose"/></div><div class="hangout-copy"><p class="eyebrow">PUT THE PHONE DOWN. PICK A CARD.</p><h2>Kopi, kad<br/>& <em>kawan.</em></h2><p>Ajak geng. Order your favourites. Settle in with card games, board games, and the kind of conversations that deserve another cup.</p><p class="handwritten">“Last round” — famous last words.</p><a class="button light" href={directions} target="_blank" rel="noopener">Make it a Cose night <Arrow /></a></div></section>
    <section id="catering" class="catering section"><p class="eyebrow">TAKE A LITTLE COSE WITH YOU</p><div class="section-heading"><h2>Your occasion.<br/>Our <em>coffee.</em></h2><div><p>Bring Cose to your next gathering.<br/>Tell us what you’re planning and enquire<br/>about our coffee catering options.</p><a class="text-link" href="#enquire">Let’s brew something together <Arrow /></a></div></div><div class="catering-strip"><span>GOOD COFFEE</span><span>✳</span><span>WHEREVER YOU GATHER</span><span>✳</span><span>MADE FOR COMPANY</span></div></section>
    <section id="enquire" class="enquiry section"><div><p class="eyebrow">DROP US A LITTLE HELLO</p><h2>What’s<br/><em>brewing?</em></h2><p>A coffee cart for your event?<br/>A gathering in mind? Just a question?<br/>We’re all ears.</p><a class="text-link" href="https://wa.me/60183856393" target="_blank" rel="noopener">Or chat with us directly <Arrow /></a></div><form id="enquiry-form"><div class="form-row"><label>Your name<input name="name" autocomplete="name" placeholder="What should we call you?" required maxlength="100"/></label><div class="enquiry-select"><span id="type-label">I’m enquiring about</span><input type="hidden" name="type" id="enquiry-type" value="General enquiry"/><button type="button" id="type-trigger" aria-haspopup="listbox" aria-expanded="false" aria-labelledby="type-label type-value"><span id="type-value">General enquiry</span><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg></button><ul id="type-options" role="listbox" aria-labelledby="type-label" hidden>{['General enquiry','Coffee catering','Private event'].map((value,i)=><li role="option" aria-selected={i===0?'true':'false'} tabindex="-1" data-value={value}>{value}</li>)}</ul></div></div><fieldset id="event-fields" hidden disabled><legend>A few event details</legend><div class="form-row"><label>Event date<input type="date" name="date" required/></label><label>Time<input type="time" name="time" required/></label></div><div class="form-row"><label>Location<input name="location" placeholder="Venue or area" required maxlength="200"/></label><label>Estimated guests<input type="number" name="guests" min="1" max="100000" required placeholder="e.g. 80"/></label></div><label>Event type<input name="event" placeholder="Birthday, wedding, office gathering…" required maxlength="100"/></label></fieldset><label>Your message<textarea name="message" rows="3" placeholder="Tell us a little about what you have in mind…" required maxlength="2000"></textarea></label><button class="button" type="submit">Continue on WhatsApp <span><Arrow /></span></button><p class="form-note">This opens WhatsApp with your enquiry filled in. Review it and press Send there. This website doesn’t submit or store your answers.</p><p id="form-status" role="status"></p></form></section>
    <section id="visit" class="visit section"><div><p class="eyebrow">THERE’S A SEAT FOR YOU</p><h2>See you<br/>at <em>Cose.</em></h2><a class="button light" href={directions} target="_blank" rel="noopener">Get directions <Arrow /></a></div><div class="visit-details"><div><h3>Find our little corner</h3><p>2, Jalan Pandan Kemajuan A,<br/>Kampung Pandan Dalam,<br/>55100 Kuala Lumpur.</p></div><div><h3>From afternoon, till late</h3><p>Sunday–Thursday <span>3pm–12am</span><br/>Friday–Saturday <span>3pm–1am</span></p><small>Hours supplied from Instagram; to be confirmed.</small></div><a href="tel:+60183856393">+60 18-385 6393 <Arrow /></a></div></section>
  </main><footer><a class="footer-brand" href="#">cose.</a><p>Coffee tastes better with company.</p><div><a href="https://www.instagram.com/cosebrew/" target="_blank" rel="noopener">Instagram <Arrow /></a><a href="https://www.threads.com/@cosebrew" target="_blank" rel="noopener">Threads <Arrow /></a><a href="https://www.tiktok.com/@cosebrew" target="_blank" rel="noopener">TikTok <Arrow /></a></div><small>Unofficial pitch concept for Cose Brew.</small></footer><div class="mobile-bar"><a href="#menu">View menu</a><a href={directions} target="_blank" rel="noopener">Get directions <Arrow /></a></div>
</body></html>
<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
  function activate(index:number) {tabs.forEach((tab,i)=>{tab.setAttribute('aria-selected',String(i===index));tab.tabIndex=i===index?0:-1;document.getElementById(tab.getAttribute('aria-controls')!)!.hidden=i!==index;});}
  tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>activate(index));tab.addEventListener('keydown',event=>{let next=index;if(event.key==='ArrowRight')next=(index+1)%tabs.length;else if(event.key==='ArrowLeft')next=(index-1+tabs.length)%tabs.length;else if(event.key==='Home')next=0;else if(event.key==='End')next=tabs.length-1;else return;event.preventDefault();activate(next);tabs[next].focus();});});
  const type=document.querySelector<HTMLInputElement>('#enquiry-type')!;
  const fields=document.querySelector<HTMLFieldSetElement>('#event-fields')!;
  type.addEventListener('change',()=>{const show=type.value!=='General enquiry';fields.hidden=!show;fields.disabled=!show;});
  const trigger=document.querySelector<HTMLButtonElement>('#type-trigger')!;
  const list=document.querySelector<HTMLUListElement>('#type-options')!;
  const options=Array.from(list.querySelectorAll<HTMLElement>('[role="option"]'));
  function closeOptions(restore=false){list.hidden=true;trigger.setAttribute('aria-expanded','false');if(restore)trigger.focus();}
  function openOptions(index=options.findIndex(option=>option.dataset.value===type.value)){list.hidden=false;trigger.setAttribute('aria-expanded','true');options[Math.max(0,index)].focus();}
  function chooseOption(option:HTMLElement){type.value=option.dataset.value!;document.querySelector('#type-value')!.textContent=type.value;options.forEach(item=>item.setAttribute('aria-selected',String(item===option)));type.dispatchEvent(new Event('change'));closeOptions(true);}
  trigger.addEventListener('click',()=>list.hidden?openOptions():closeOptions());
  trigger.addEventListener('keydown',event=>{if(event.key==='ArrowDown'||event.key==='ArrowUp'){event.preventDefault();openOptions(event.key==='ArrowUp'?options.length-1:undefined);}});
  options.forEach((option,index)=>{option.addEventListener('click',()=>chooseOption(option));option.addEventListener('keydown',event=>{if(event.key==='Enter'||event.key===' '){event.preventDefault();chooseOption(option);}else if(event.key==='Escape'){event.preventDefault();closeOptions(true);}else if(['ArrowDown','ArrowUp','Home','End'].includes(event.key)){event.preventDefault();const next=event.key==='Home'?0:event.key==='End'?options.length-1:(index+(event.key==='ArrowDown'?1:-1)+options.length)%options.length;options[next].focus();}else if(event.key==='Tab'){closeOptions(true);}else if(event.key.length===1){const match=options.find(item=>item.textContent?.toLowerCase().startsWith(event.key.toLowerCase()));match?.focus();}});});
  document.addEventListener('click',event=>{if(!(event.target as Element).closest('.enquiry-select'))closeOptions();});

  document.querySelector<HTMLFormElement>('#enquiry-form')!.addEventListener('submit',event=>{event.preventDefault();const form=event.currentTarget as HTMLFormElement;if(!form.reportValidity())return;const data=new FormData(form);let message=`Hi Cose! My name is ${data.get('name')}.\nEnquiry: ${data.get('type')}`;if(!fields.disabled)message+=`\nEvent: ${data.get('event')}\nDate: ${data.get('date')}\nTime: ${data.get('time')}\nLocation: ${data.get('location')}\nEstimated guests: ${data.get('guests')}`;message+=`\n\n${data.get('message')}`;window.open('https://wa.me/60183856393?text='+encodeURIComponent(message),'_blank','noopener,noreferrer');document.querySelector('#form-status')!.textContent='Your message is ready in WhatsApp. Press Send there to complete your enquiry.';});
</script>
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=DM+Serif+Display:ital@0;1&display=swap');
  #enquiry-form input:not([type="hidden"]),#enquiry-form textarea{padding:13px 10px;margin-top:6px;transition:background-color .15s,border-color .15s,box-shadow .15s}#enquiry-form input:not([type="hidden"]):focus,#enquiry-form textarea:focus{outline:none;border-bottom-color:var(--wine);background:#f7f0e480;box-shadow:inset 0 0 0 1px var(--wine)}#enquiry-form input::placeholder,#enquiry-form textarea::placeholder{color:var(--muted);opacity:1}#enquiry-form input:-webkit-autofill{-webkit-text-fill-color:var(--ink);box-shadow:inset 0 0 0 1000px var(--cream)}#enquiry-form input:-webkit-autofill:focus{outline:1px solid var(--wine);outline-offset:-1px}
  .enquiry-select{position:relative;min-width:0;margin-bottom:23px;font-size:11px}.enquiry-select>span{display:block;margin-bottom:3px}#type-trigger{display:flex;align-items:center;justify-content:space-between;gap:12px;width:100%;padding:13px 0;background:transparent;border:0;border-bottom:1px solid #b9aa95;color:var(--ink);font-size:12px;text-align:left;cursor:pointer}#type-trigger:focus-visible{outline-offset:2px}#type-options{position:absolute;top:100%;left:0;right:0;z-index:20;margin:6px 0 0;padding:6px;list-style:none;background:var(--cream);border:1px solid var(--line);border-radius:5px;box-shadow:0 10px 25px #2e28231a}#type-options li{padding:12px 10px;border-radius:3px;font-size:12px;cursor:pointer;outline:none}#type-options li:hover,#type-options li:focus{background:#e8d5b5}#type-options li[aria-selected=true]{background:var(--wine);color:var(--cream)}
  .arrow-icon{display:inline-block;width:1em;height:1em;vertical-align:-.12em;flex-shrink:0}
  :root{--wine:#78171c;--cream:#f7f0e4;--ink:#2e2823;--muted:#766d62;--line:#d9cebc}*{box-sizing:border-box}html{scroll-behavior:smooth;scroll-padding-top:24px}body{margin:0;background:var(--cream);color:var(--ink);font-family:'DM Sans',sans-serif;font-size:15px}a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}button,a,input,textarea,select{-webkit-tap-highlight-color:transparent}a:focus-visible,button:focus-visible,input:focus-visible,textarea:focus-visible,select:focus-visible{outline:3px solid #b97936;outline-offset:5px}img{display:block;width:100%;height:100%;object-fit:cover}[hidden]{display:none!important}.concept{background:var(--wine);color:var(--cream);font-size:11px;letter-spacing:.03em;text-align:center;padding:9px 16px}.concept span{opacity:.7;margin-left:12px}header{max-width:1440px;margin:auto;height:104px;padding:0 6%;display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid var(--line)}.brand{display:flex;align-items:center;gap:10px;font-size:36px;font-weight:700;letter-spacing:-2px;color:var(--wine)}.brand img{width:42px;height:42px;border-radius:50%}.brand-dot{letter-spacing:0}nav{display:flex;gap:34px;font-size:13px}.nav-cta{border:1px solid var(--wine);border-radius:30px;padding:12px 21px;color:var(--wine);font-size:13px}.nav-cta span{margin-left:20px}.hero{max-width:1440px;margin:auto;display:grid;grid-template-columns:1.04fr 1fr;padding:56px 6% 65px;gap:5%}.eyebrow{font-size:10px;letter-spacing:1.8px;font-weight:700;margin:0 0 26px}.tiny-star{font-size:18px;margin-right:6px}h1,h2{font-family:'DM Serif Display',Georgia,serif;font-weight:400;letter-spacing:-2.5px;line-height:1.02;margin:0;color:var(--wine)}h1{font-size:clamp(64px,6.4vw,94px)}h1 em,h2 em{font-weight:400}h2{font-size:clamp(46px,4.8vw,68px)}.intro{font-size:14px;line-height:1.8;margin:26px 0 28px;color:var(--muted)}.actions{display:flex;gap:26px;align-items:center}.button{display:inline-flex;gap:28px;align-items:center;justify-content:space-between;border:0;border-radius:3px;background:var(--wine);color:var(--cream);padding:17px 23px;font-size:12px;cursor:pointer;transition:transform .2s}.button:hover{transform:translateY(-3px)}.text-link{font-size:12px;border-bottom:1px solid;padding-bottom:5px;display:inline-block}.hero-foot{display:flex;justify-content:space-between;margin-top:50px;padding-top:19px;border-top:1px solid var(--line);font-size:9px;letter-spacing:1px}.hero-art{position:relative;padding:10px 15px 16px 0;min-height:540px}.hero-photo{border-radius:180px 180px 3px 3px;object-position:center 48%;max-height:610px}.photo-note{position:absolute;bottom:25px;left:-24px;background:#f0dbaa;padding:20px 25px;transform:rotate(-6deg);font-family:Georgia,serif;font-size:20px;box-shadow:0 4px 15px #0001}.photo-note span{font-size:33px;margin-left:30px}.roundel{position:absolute;right:-20px;top:35px;width:112px;height:112px;border-radius:50%;background:var(--wine);color:var(--cream);border:1px dashed #edce9e;outline:7px solid var(--wine);display:flex;align-items:center;justify-content:center;flex-direction:column;font-size:8px;letter-spacing:1px;transform:rotate(12deg)}.roundel b{font-size:31px;letter-spacing:-2px;line-height:.7}.ticker{display:flex;justify-content:space-around;gap:20px;overflow:hidden;white-space:nowrap;background:#e8d5b5;color:var(--wine);padding:19px 20px;font-size:20px}.ticker span{font-size:12px;font-weight:700;letter-spacing:2px;align-self:center}.section{padding:90px 8%;max-width:1440px;margin:auto}.section-heading{display:flex;justify-content:space-between;align-items:flex-end;gap:35px;margin-bottom:42px}.section-heading p:not(.eyebrow){font-size:13px;line-height:1.8;color:var(--muted)}.favourite-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:8%;align-items:center}.feature-photo{margin:0;height:435px;position:relative}.feature-photo img{border-radius:4px;object-position:center 52%}.feature-photo figcaption{font-size:9px;color:var(--muted);padding-top:10px}.